[
  {"type": "reaccion", "id": "madera_se_enciende",
   "cuando": [{"path": "material.inflamable", "op": "==", "valor": true},
              {"path": "ambiente.temperatura_C", "op": ">=", "valor": "@material.punto_ignicion_C"}],
   "efectos": [{"tipo": "estado", "valor": "ardiendo"}, {"tipo": "emitir_calor", "valor_C": 800},
               {"tipo": "evento", "texto": "{objeto} se prendió fuego."}]},
  {"type": "reaccion", "id": "metal_se_ablanda",
   "cuando": [{"path": "material.punto_ablandamiento_C", "op": "existe"},
              {"path": "cuerpo.temperatura_C", "op": ">=", "valor": "@material.punto_ablandamiento_C"},
              {"path": "cuerpo.temperatura_C", "op": "<", "valor": "@material.punto_fusion_C"}],
   "efectos": [{"tipo": "estado", "valor": "blando"},
               {"tipo": "evento", "texto": "{objeto} se puso al rojo y se puede forjar."}]},
  {"type": "reaccion", "id": "material_se_funde",
   "cuando": [{"path": "material.punto_fusion_C", "op": "existe"},
              {"path": "cuerpo.temperatura_C", "op": ">=", "valor": "@material.punto_fusion_C"}],
   "efectos": [{"tipo": "estado", "valor": "fundido"},
               {"tipo": "evento", "texto": "{objeto} se fundió."}]},
  {"type": "reaccion", "id": "rayo_en_conductor",
   "cuando": [{"path": "material.conduce_electricidad", "op": "==", "valor": true},
              {"path": "ambiente.descarga_electrica", "op": "==", "valor": true}],
   "efectos": [{"tipo": "dano", "cantidad": 60, "causa": "descarga eléctrica"},
               {"tipo": "emitir_calor", "valor_C": 200},
               {"tipo": "evento", "texto": "Una descarga eléctrica recorrió {objeto}."}]},
  {"type": "reaccion", "id": "agua_apaga_fuego",
   "cuando": [{"path": "material.id", "op": "==", "valor": "agua"},
              {"path": "ambiente.hay_fuego", "op": "==", "valor": true}],
   "efectos": [{"tipo": "apagar_fuego"}, {"tipo": "evento", "texto": "El agua apagó el fuego."}]}
]
